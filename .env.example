# Assay needs none of these to run. With no variables at all the demo works, AI findings report that they
# are off, and team workspaces and email stay disabled. Set them in your host's environment settings.

# AI judgment: one or more Google Gemini API keys, comma separated.
GEMINI_API_KEYS=

# Email: fact-expiry alerts and team sign-in links.
# Gmail example, with an app password and no spaces: smtps://ADDRESS%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
EMAIL_FROM=Assay <ADDRESS@example.com>

# Team workspaces: a Postgres database. The pooled URL serves requests and the unpooled one runs migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs the daily alert job's requests, and sets the address used in emailed links.
# Generate the secret with: openssl rand -hex 32
CRON_SECRET=
APP_ORIGIN=http://localhost:3000
